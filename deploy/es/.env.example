# 复制为 deploy/es/.env 后由 scripts/es-up.sh 自动生成随机值
# 这个文件本身是模板，可以提交；真实 .env 不提交
ELASTIC_PASSWORD=change-me
# 认证方式：Basic Auth（用户名 + 密码），不再使用 API key（见文档 §5.6 / D6）
# 下面三个密码由 scripts/init-security.sh 生成；恢复时原样重建，客户端零改动
MEM_READER_PASSWORD=
MEM_WRITER_PASSWORD=
MEM_CONSOLIDATOR_PASSWORD=
# 身份：本机代表哪个用户（对应 personal_memory.user_id，索引名由它派生）
MEM_USER_ID=xqh
CERT_PASS=changeme

# ---- 整理任务 / 审核台（consolidate/cli.ts）用的可选项 ----
# 索引名与向量端点：换部署（比如 .125 的容器要访问宿主 Ollama）时改这里，不改代码
MEM_PERSONAL_PREFIX=personal_memory_
MEM_TEAM_INDEX=team_knowledge
MEM_AUDIT_INDEX=memory_audit
MEM_EMBEDDING_URL=http://127.0.0.1:11434
MEM_EMBEDDING_MODEL=bge-m3
# 必须与索引 mapping 的 dense_vector dims 一致，否则 knnBody 直接抛错
MEM_EMBEDDING_DIMS=1024

{
  "name": "dsh-memory-es",
  "version": "0.6.55",
  "description": "DSH 记忆插件：Elasticsearch 双层记忆库（团队知识 + 个人记忆）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "elasticsearch"
  ],
  "homepage": "https://github.com/xqh0405/dsh-memory-es",
  "repository": {
    "type": "git",
    "url": "https://github.com/xqh0405/dsh-memory-es.git"
  },
  "author": "xqh0405",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./panel": "./panel/index.js",
    "./client": "./panel/client.js",
    "./locale/*.json": "./panel/locale/*.json",
    "./icon": "./panel/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "panel",
    "cordis.patch.yml",
    "persona"
  ],
  "engines": {
    "dsh": ">=0.1.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "test:integration": "bash scripts/test.sh integration",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "eval": "node scripts/eval-search.ts",
    "eval:prod": "node scripts/eval-search.ts --gate",
    "eval:thresholds": "node scripts/eval-thresholds.ts",
    "eval:contracts": "node scripts/eval-contracts.ts",
    "eval:contracts:gate": "node scripts/eval-contracts.ts --gate",
    "check:contracts": "node scripts/check-contracts.ts",
    "tune": "node scripts/tune.ts"
  },
  "icon": "./panel/icon.svg"
}
